# SunGET Solar Infra website — configuration reference
#
# This is a static website (plain HTML/CSS/JS). Browsers cannot read .env
# files, so these values are NOT loaded automatically. The live values are in
# src/sg-config.js (window.SG_CONFIG). This file lists what has to be set
# there, so a new deployment / new Supabase project can be configured.

# Supabase project URL (Project Settings > API > Project URL)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase PUBLISHABLE / anon key (Project Settings > API keys > Publishable key).
# Safe in the browser ONLY with Row Level Security enabled (supabase/schema.sql).
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Business WhatsApp number, international format without "+" (used by the solar calculator)
WHATSAPP_NUMBER=91XXXXXXXXXX

# Phone number as shown to visitors
PHONE_DISPLAY="+91 XXXXX XXXXX"

# NEVER put these in the website or in src/sg-config.js:
#   SUPABASE_SERVICE_ROLE_KEY / secret key  -> server-side only (Supabase dashboard, SQL editor, CI)
#   database password
